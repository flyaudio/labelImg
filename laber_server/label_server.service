[Unit]
Description=Lightweight remote label server controller
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/laber_server
EnvironmentFile=-/etc/laber_server.env
Environment=LABEL_SERVER_HOST=0.0.0.0
Environment=LABEL_SERVER_PORT=8001
ExecStart=/usr/bin/python3 /opt/laber_server/label_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
